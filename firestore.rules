rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - GLOBAL TRADING CHINA
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Client Hub Rules ---
    // Règles pour les données spécifiques aux clients inscrits

    match /clients/{clientId} {
      // Autorise la lecture/écriture pour le fonctionnement du profil et de l'admin
      allow read, write: if true; 

      match /productLists/{productListId} {
        allow read, write: if true; 

        match /products/{productId} {
          allow read, write: if true;
        }
      }
    }

    // --- Root Collections (Admin & Shared) ---
    // On autorise l'accès aux collections principales pour le dashboard et l'espace client.
    
    match /orders/{id} { allow read, write: if true; }
    match /invoices/{id} { allow read, write: if true; }
    match /products/{id} { allow read, write: if true; }
    match /customers/{id} { allow read, write: if true; }
    match /contactSubmissions/{id} { allow read, write: if true; }
    match /packingLists/{id} { allow read, write: if true; }
    match /quotes/{id} { allow read, write: if true; }
    match /suppliers/{id} { allow read, write: if true; }
    match /supplierContracts/{id} { allow read, write: if true; }
    match /companyInfo/{id} { allow read, write: if true; }
    match /config/{id} { allow read, write: if true; }

    // Règle par défaut pour toute autre donnée
    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}