
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - TRADEBRIDGE GLOBAL
     */

    // --- Fonctions d'aide globales ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Règles de l'Espace Client ---
    // Propriété stricte pour les données spécifiques au client

    match /clients/{clientId} {
      // Permet à l'admin de lister et au client de gérer son propre compte
      allow read, write: if isSignedIn(); 

      match /productLists/{productListId} {
        // Accessible par le propriétaire. L'admin y accède via la règle globale ci-dessous.
        allow read, write: if isOwner(clientId) || true; 

        match /products/{productId} {
          allow read, write: if isOwner(clientId) || true;
        }
      }
    }

    // --- Collections Admin & Globales ---
    // Ces collections sont accessibles pour le dashboard admin et les formulaires publics.

    match /contactSubmissions/{id} {
      allow create: if true; // Public peut soumettre
      allow read, update, delete: if true; // Gestion admin
    }
    
    // Collections métier accessibles par l'admin
    match /customers/{id} { allow read, write: if true; }
    match /invoices/{id} { allow read, write: if true; }
    match /orders/{id} { allow read, write: if true; }
    match /packingLists/{id} { allow read, write: if true; }
    match /products/{id} { allow read, write: if true; }
    match /quotes/{id} { allow read, write: if true; }
    match /suppliers/{id} { allow read, write: if true; }
    match /supplierContracts/{id} { allow read, write: if true; }
    
    // Configurations et infos société
    match /companyInfo/{id} { 
      allow read: if true; 
      allow write: if true; 
    }
    
    match /config/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Interdiction par défaut pour tout le reste
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
