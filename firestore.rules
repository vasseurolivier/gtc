rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - GLOBAL TRADING CHINA
     * Version consolidée pour corriger les erreurs de permissions (list/get)
     */

    // --- Fonctions d'aide ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- RÈGLE GLOBALE DE DÉBOGAGE / PROTOTYPE ---
    // On autorise la lecture et l'écriture sur toutes les collections racine
    // pour éviter les blocages de l'admin et du catalogue client.
    
    match /invoices/{id} { allow read, write: if true; }
    match /orders/{id} { allow read, write: if true; }
    match /products/{id} { allow read, write: if true; }
    match /customers/{id} { allow read, write: if true; }
    match /contactSubmissions/{id} { allow read, write: if true; }
    match /packingLists/{id} { allow read, write: if true; }
    match /quotes/{id} { allow read, write: if true; }
    match /suppliers/{id} { allow read, write: if true; }
    match /supplierContracts/{id} { allow read, write: if true; }
    match /companyInfo/{id} { allow read, write: if true; }
    match /config/{id} { allow read, write: if true; }

    // --- Espace Client (Subcollections) ---
    // On s'assure que les données nichées sous /clients sont aussi accessibles
    match /clients/{clientId} {
      allow read, write: if true; 
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Règle par défaut pour toute autre donnée (ex: logs, etc.)
    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}