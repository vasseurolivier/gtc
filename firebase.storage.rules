rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Autorise la lecture et l'écriture de tous les fichiers.
    // Pour une application en production, il est fortement recommandé
    // de restreindre cet accès, par exemple en autorisant uniquement
    // les utilisateurs authentifiés à écrire dans leurs propres dossiers.
    // Exemple : allow write: if request.auth != null;
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
